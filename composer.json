{
    "name": "b13/db-file-storage",
    "type": "typo3-cms-extension",
    "description": "Store uploaded files directly in the TYPO3 database. A tiny, injectable service usable from Extbase and any PSR-15 / ActionController.",
    "license": "GPL-2.0-or-later",
    "homepage": "https://b13.com",
    "keywords": ["TYPO3 CMS", "file", "storage", "database", "upload"],
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^13.4 || ^14.2",
        "typo3/cms-extbase": "^13.4 || ^14.2",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-factory": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0",
        "typo3/coding-standards": "^0.8.0",
        "typo3/testing-framework": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "B13\\DbFileStorage\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "B13\\DbFileStorage\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "db_file_storage"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true
        }
    }
}
